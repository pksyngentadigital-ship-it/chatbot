{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,scripts/**,templates/**,public/**,**/__pycache__/**,vog_core.py,main.py,app.py,shared_state.py,pytest.ini,Procfile}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ]
}
